benchmark:
    SERVER_CONFIG=./configs/server_benchmark.xml \
    SERVER_RUNTIME="" bot_server

run:
    cd ..; just setup-from-src
    uv run -m alti_rl.online_client should-final-month-city

index:
    make -C .. bin/index-lite
    index-lite --path ${ALTI_HOME}/recordings \
        --db ${ALTI_HOME}/recordings.db

view:
    mkdir -p viewer/js
    cp ../hx_src/out/viewer.js viewer/js/
    cd viewer && \
        DB_PATH=${ALTI_HOME}/recordings.db uv run app.py
